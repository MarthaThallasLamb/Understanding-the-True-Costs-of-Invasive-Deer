#Create cost functions
#Create grazing cost function
grazing_cost <- function(
    biomass,
    farmland_prop,
    dse_per_tonne,
    gross_margin_dse
){
#calcualtion
  biomass *
    farmland_prop *
    dse_per_tonne *
    gross_margin_dse
}

#create function of farmour labour costs
management_cost <- function(
    n_farms,
    prop_affected,
    days,
    hours_day,
    wage
){
#caluclation
  affected <- n_farms * prop_affected
  affected *
    days *
    hours_day *
    wage
}

#create function of lost forestry yield costs
forestry_cost <- function(
    production_m3,
    prop_affected,
    yield_loss,
    price_m3
){
#calculation
  production_m3 *
    prop_affected *
    yield_loss *
    price_m3
}

